{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "status",
      "rating",
      "reviewCount",
      "location",
      "description",
      "price",
      "duration"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "string",
        "minLength": 1
      },
      "rating": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      },
      "reviewCount": {
        "type": "integer",
        "minimum": 0
      },
      "location": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "price": {
        "type": "string",
        "minLength": 1
      },
      "duration": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
